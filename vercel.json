{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/chat",
      "destination": "/api/chat"
    },
    {
      "source": "/api/news",
      "destination": "/api/news"
    },
    {
      "source": "/india-partners.csv",
      "destination": "/india-partners.csv"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "functions": {
    "api/chat.ts": {
      "maxDuration": 10
    },
    "api/news.ts": {
      "maxDuration": 15
    }
  }
}
